{
  "name": "Bulk Global Carrier Lookup",
  "brand": "CarrierLookup",
  "repository": "carrierlookup/bulk-carrier-lookup-api",
  "description": "Upload a whole file of numbers and download the carrier data when the task finishes.",
  "official_site": "https://carrierlookup.online",
  "landing_page": "https://carrierlookup.online/products/global_carrier_batch",
  "canonical_docs": "https://carrierlookup.online/api-docs",
  "base_url": "https://carrierlookup.online",
  "auth": {
    "type": "api_key",
    "header": "X-API-Key"
  },
  "mode": "async-bulk",
  "product": "global_carrier_batch",
  "identifier_kind": "phone",
  "requires_country": true,
  "endpoints": {
    "submit": {
      "method": "POST",
      "path": "/api/v1/bulk-tasks"
    },
    "status": {
      "method": "GET",
      "path": "/api/v1/bulk-tasks/{id}"
    },
    "balance": {
      "method": "GET",
      "path": "/api/v1/balance"
    }
  },
  "limits": {
    "min_items": 1000,
    "max_items": 100000,
    "poll_interval_seconds": 30,
    "file_formats": [
      "txt",
      "csv"
    ]
  },
  "result_fields": [
    {
      "name": "number",
      "example": "17253100591",
      "description": ""
    },
    {
      "name": "carrier",
      "example": "T-Mobile",
      "description": ""
    },
    {
      "name": "underlying_carrier",
      "example": "",
      "description": ""
    },
    {
      "name": "number_type",
      "example": "Fixed Line or Mobile",
      "description": ""
    },
    {
      "name": "country_code",
      "example": "US",
      "description": ""
    },
    {
      "name": "region",
      "example": "NV",
      "description": ""
    },
    {
      "name": "city",
      "example": "LAS VEGAS",
      "description": ""
    }
  ],
  "statuses": [
    "processing",
    "success",
    "failed"
  ],
  "pricing_url": "https://carrierlookup.online/pricing",
  "maintainer": "CarrierLookup",
  "license": "MIT",
  "last_reviewed": "2026-09-22"
}
